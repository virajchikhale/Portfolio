# Environment variables for the Vercel deployment. Set them in Vercel → Project → Settings → Environment Variables
# (or copy this file to .env for `npm run smoke` / `vercel dev`). Never commit real keys.

# ── LLM (pick one provider) ─────────────────────────────────────
LLM_PROVIDER=gemini              # gemini | openai (any OpenAI-compatible API, e.g. Groq) | fake (offline demo)
GEMINI_API_KEY=                  # Gemini: LLM + embeddings. Free key: aistudio.google.com
LLM_MODEL=gemini-2.5-flash
# openai provider, e.g. Groq (free key: console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_BUDGET=0            # Gemini only. 0 = thinking off; -1 = model default (needed for Pro models)
# LLM_TIMEOUT_S=45               # pipeline mode: wall-clock limit for one model call

# ── Retrieval ───────────────────────────────────────────────────
# gemini = dense + keyword search (document vectors are precomputed: `npm run embed`); none = keyword search only.
# Default: gemini when GEMINI_API_KEY is set, otherwise none.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
RAG_TOP_K=4
# RAG_MIN_SCORE=                 # unset = calibrated default (0.60 for gemini-embedding-001): `npm run eval:retrieval`

# ── Agent mode ──────────────────────────────────────────────────
AGENT_ENABLED=true
AGENT_MAX_STEPS=4                # model calls per question; each also counts against DAILY_GLOBAL_REQUEST_BUDGET
AGENT_MAX_TOOL_CALLS=6
AGENT_FALLBACK=true              # if the agent cannot answer, use the fast pipeline instead of showing an error
# AGENT_TIMEOUT_S=50             # keep below the function's maxDuration (60 s, see vercel.json)

# ── Abuse protection ────────────────────────────────────────────
MAX_INPUT_CHARS=800
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
DAILY_GLOBAL_REQUEST_BUDGET=1500
# Shared counters + run statistics across all function instances: add "Upstash Redis" from the Vercel Marketplace
# (free tier); it sets these two automatically. Without it, limits are per warm instance (best effort).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── MCP endpoint (POST /mcp, read-only tools, no LLM calls) ─────
MCP_HTTP_ENABLED=true
# MCP_AUTH_TOKEN=                # set to require "Authorization: Bearer <token>"

# ── Telemetry (privacy by default) ──────────────────────────────
TELEMETRY_ENABLED=true
TELEMETRY_STORE_QUESTIONS=false  # true keeps the visitor's question text in run summaries (privacy trade-off)
# ADMIN_TOKEN=                   # set to enable GET /api/admin/runs (Authorization: Bearer <token>)

# ── HTTP ────────────────────────────────────────────────────────
# CORS_ORIGINS=                  # only if the frontend is served from a DIFFERENT origin than the API
# (set apiBase in frontend/config.js in that case). Same-origin on Vercel needs nothing.
