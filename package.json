{
  "name": "vc-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VC\u00b7OS portfolio: static frontend + TypeScript API (Vercel Functions)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:retrieval": "tsx --env-file=.env scripts/eval-retrieval.ts",
    "dev": "vercel dev",
    "embed": "tsx scripts/embed.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts"
  },
  "dependencies": {
    "@vercel/functions": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
