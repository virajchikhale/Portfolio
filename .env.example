# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=gemini            # gemini | fake (fake = offline, no key needed)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash     # any Gemini model id you have access to
LLM_MAX_OUTPUT_TOKENS=512

ENVIRONMENT=dev                # prod disables /docs and /openapi.json
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY_HEADERS=true       # true only behind the bundled nginx / your own proxy

MAX_INPUT_CHARS=800
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
DAILY_GLOBAL_REQUEST_BUDGET=1500
