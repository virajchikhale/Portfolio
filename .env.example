# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=gemini            # gemini | fake (fake = offline, no key needed)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash     # any Gemini model id you have access to
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_BUDGET=0          # 0 = thinking off; -1 = model default (needed for Pro models)

ENVIRONMENT=dev                # prod disables /docs and /openapi.json
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY_HEADERS=true       # true only behind the bundled nginx / your own proxy

MAX_INPUT_CHARS=800
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
DAILY_GLOBAL_REQUEST_BUDGET=1500

# ── RAG / pgvector ──────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-letters-and-digits-only   # REQUIRED by docker compose; keep it URL-safe (no @ : / # ?)
# POSTGRES_USER=portfolio
# POSTGRES_DB=portfolio
EMBEDDING_PROVIDER=local       # local (fastembed, CPU, no API/quota) | gemini | fake (tests only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # local: any fastembed model; gemini: e.g. gemini-embedding-001
# EMBEDDING_DIM=               # leave unset: derived from the model (384 for MiniLM, 768 for Gemini here)
# After changing provider/model, rebuild (the model is baked into the image) and run:
#   docker compose run --rm backend python -m app.rag.ingest --reset
RAG_TOP_K=4
# RAG_MIN_SCORE=              # unset = calibrated default for the model; tune with: python backend/scripts/eval_retrieval.py
INGEST_ON_STARTUP=true         # embeds only new/changed chunks
# Local (non-docker) run without Postgres:  VECTOR_STORE=memory
